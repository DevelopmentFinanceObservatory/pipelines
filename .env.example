# Replace path/to/repo with the absolute path to this repository

# Where Dagster stores run history and metadata, so they persist across `dg dev` restarts
DAGSTER_HOME=path/to/repo/.dagster_home

# Whether automation starts RUNNING or STOPPED on a new local instance
AUTOMATION_SENSOR_DEFAULT_STATUS=STOPPED

# The DuckDB database the pipelines read and write
DUCKDB_PATH=path/to/repo/data/dfo.duckdb

# Which dbt tests run alongside a subset of models. dbt's default, eager, also runs
# tests that join a selected model to another source's tables, which fail when that
# source has never been built locally. buildable keeps every test whose parents are
# selected or upstream of the selection, so one pipeline runs on its own.
DBT_INDIRECT_SELECTION=buildable

# The Data Commons Platform instance that bundles are ingested into.
# Only the ingestion assets read these, so the rest of the project runs without them.
# Uncomment and set them to ingest.
# DCP_PROJECT_ID=
# DCP_REGION=
# DCP_BUCKET_NAME=
# DCP_WORKFLOW_NAME=

# The GitHub repository the DFO agent skills are fetched from. Only the skills assets read it.
DFO_SKILLS_REPOSITORY_URL=https://github.com/DevelopmentFinanceObservatory/skills
