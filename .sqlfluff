[sqlfluff]
dialect = duckdb
# int_ids_mapped nests three array_to_string joins through mint_ids_statvar_name.
max_parse_depth = 400
templater = dbt
max_line_length = 100

[sqlfluff:templater:dbt]
project_dir = dbt
profiles_dir = dbt


[sqlfluff:rules:references.keywords]
# Allowing for DC consistency
ignore_words = value,year,variable,date,name
