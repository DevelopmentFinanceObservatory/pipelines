Node: dcid:dataTransformationDescription
typeOf: schema:Property
name: "data transformation description"
description: "A plain-language explanation, in Markdown, of how the source data is transformed before import, describing the current state of the dataset."
domainIncludes: dcid:Provenance
rangeIncludes: schema:Text

Node: dcid:dataTransformationChangelog
typeOf: schema:Property
name: "data transformation changelog"
description: "Dated entries, in Markdown and newest first, recording each change to how the source data is transformed before import."
domainIncludes: dcid:Provenance
rangeIncludes: schema:Text
